# Copy to the repo root as .env (gitignored). The app and tests read these.
# Production values live in the cluster as the `two-feet-env` secret (infra/layers/secrets.env).

# Postgres. Local compose by default; PlanetScale in production (sslmode=verify-full there).
DATABASE_URL=postgres://twofeet:twofeet@localhost:5432/twofeet?sslmode=disable

# Elasticsearch. Local compose has security off; Elastic Cloud needs ELASTIC_API_KEY.
ELASTIC_URL=http://localhost:9200
ELASTIC_API_KEY=

# Clerk (dashboard.clerk.com → API keys). Use the development instance locally.
CLERK_PUBLISHABLE_KEY=pk_test_
CLERK_SECRET_KEY=sk_test_

# OpenTelemetry. Locally, send to the compose collector.
OTEL_SERVICE_NAME=two-feet
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_EXPORTER_OTLP_INSECURE=true

# Optional: forward local telemetry to Dash0 through the collector.
DASH0_ENDPOINT=
DASH0_AUTH_TOKEN=
DASH0_DATASET=two-feet-dev

# The app
PORT=8080
PUBLIC_URL=http://localhost:8080
EVENT_SLUG=cnh
