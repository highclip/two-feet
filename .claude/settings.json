{
  "env": {
    "HX_RUN": "cnh-2026"
  },
  "permissions": {
    "allow": [
      "Bash(python3 harness/hx.py:*)",
      "Bash(go build:*)",
      "Bash(go test:*)",
      "Bash(go vet:*)",
      "Bash(go mod tidy:*)",
      "Bash(go get:*)",
      "Bash(go run:*)",
      "Bash(gofmt:*)",
      "Bash(templ generate:*)",
      "Bash(goose:*)",
      "Bash(golangci-lint run:*)",
      "Bash(gosec:*)",
      "Bash(govulncheck:*)",
      "Bash(gitleaks:*)",
      "Bash(npx playwright test:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(docker compose -f infra/local/compose.yaml:*)",
      "Bash(harness/gates.sh:*)",
      "Bash(scripts/spawn-builder.sh:*)",
      "Bash(ls:*)",
      "Bash(mkdir:*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(git merge:*)",
      "Bash(git fetch:*)",
      "Bash(git pull:*)",
      "Bash(git push origin main)",
      "Bash(git rev-parse:*)",
      "Bash(git worktree:*)",
      "Bash(git show:*)",
      "Bash(go fmt:*)",
      "Bash(kubectl -n two-feet rollout status:*)",
      "Bash(curl -s http://localhost:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr view:*)",
      "Bash(cd:*)",
      "Bash(go version)",
      "Bash(go env:*)",
      "Bash(cat:*)",
      "Bash(grep:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(scripts/review.sh:*)",
      "Bash(scripts/agent.sh:*)",
      "Bash(scripts/shoot.sh:*)",
      "Bash(SIZE=1920x1080 scripts/shoot.sh:*)",
      "Bash(THEME=dark scripts/shoot.sh:*)",
      "Bash(curl -s https://twofeet.highclip.dev/healthz)",
      "mcp__dash0__*"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git reset --hard:*)",
      "Read(./.env)",
      "Read(./infra/layers/secrets.env)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/harness/gates.sh",
            "timeout": 900
          }
        ]
      }
    ]
  }
}
