# Copy to infra/layers/secrets.env (gitignored) and fill in. Read by deploy.sh and
# infra/scripts/bootstrap-secrets.sh. Nothing in here is ever committed.

# kubectl context of the cluster to deploy to. deploy.sh refuses to run without it,
# so a deploy can never land on the wrong cluster (like honk) by accident.
KUBE_CONTEXT=do-sfo3-two-feet-sfo3

# Dash0 auth token (app.dash0.com → Organization settings → Auth tokens), without "Bearer".
DASH0_AUTH_TOKEN=

# Cloudflare tunnel credentials file written by `cloudflared tunnel create two-feet`.
TUNNEL_CREDENTIALS_FILE=~/.cloudflared/<tunnel-id>.json

# App environment. These become the two-feet-env secret in the two-feet namespace.
# PlanetScale: Connect → Postgres → a role with read/write, sslmode=verify-full.
DATABASE_URL=
# Elastic Cloud: the deployment's Elasticsearch endpoint and an API key with index + inference rights.
ELASTIC_URL=
ELASTIC_API_KEY=
# Clerk production instance (or development for the rehearsal).
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
